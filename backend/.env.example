# LogiSight — Environment Variables Reference
# Copy to .env and fill in values

# ─── Database ───────────────────────────────────────────────────────────
# CockroachDB Cloud (production / hackathon)
COCKROACHDB_URL=cockroachdb://<user>:<password>@<cluster-host>:26257/<db>?sslmode=verify-full

# Local PostgreSQL (development fallback)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/logisight

# ─── Amazon Cognito Auth ────────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# ─── Groq (Primary LLM for Copilot) ─────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL_ID=llama-3.3-70b-versatile

# ─── AWS Bedrock (Fallback LLM — optional) ───────────────────────────────
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ─── Amazon S3 (Invoice PDF Storage) ────────────────────────────────────
S3_INVOICE_BUCKET=logisight-invoices-hackathon
AWS_REGION=us-east-1

# ─── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN=https://<your-vercel-domain>

# ─── Veryfi OCR ──────────────────────────────────────────────────────────
VERYFI_CLIENT_ID=
VERYFI_CLIENT_SECRET=
VERYFI_USERNAME=
VERYFI_API_KEY=

# ─── Optional ────────────────────────────────────────────────────────────
SQLALCHEMY_ECHO=false
