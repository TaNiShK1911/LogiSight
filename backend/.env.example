# LogiSight backend — copy to .env and fill values
# Qwen Cloud Autopilot Agent edition

# ── Database ──────────────────────────────────────────────────────────────────
# ApsaraDB RDS for PostgreSQL (production)
# Example: postgresql+asyncpg://logisight_user:<pw>@<apsaradb-endpoint>:5432/logisight_prod
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# LangChain Copilot needs a sync URL (psycopg2) — derived from DATABASE_URL automatically
# but you can override if needed:
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Authentication ────────────────────────────────────────────────────────────
# Supabase Auth (JWT verification & admin API) — kept for backward compat
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Qwen / DashScope ─────────────────────────────────────────────────────────
# Get from https://dashscope-intl.aliyuncs.com or Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=sk-...

# ── Alibaba Cloud OSS (replaces Supabase Storage) ────────────────────────────
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
OSS_BUCKET_NAME=logisight-invoices

# ── Celery / Redis (ApsaraCache for Redis) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT / Security ───────────────────────────────────────────────────────────
SECRET_KEY=change-me-with-openssl-rand-hex-32

# ── Optional: Veryfi (fallback for PDF extraction) ───────────────────────────
VERYFI_CLIENT_ID=
VERYFI_CLIENT_SECRET=
VERYFI_USERNAME=
VERYFI_API_KEY=

# ── Optional: Email Ingestion (IMAP for autonomous invoice polling) ──────────
IMAP_SERVER=imap.gmail.com
IMAP_EMAIL=logisight-invoices@yourdomain.com
IMAP_PASSWORD=

# ── Dev / Debug ───────────────────────────────────────────────────────────────
# SQLALCHEMY_ECHO=true
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
